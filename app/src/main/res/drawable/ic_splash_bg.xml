            <gradient
                android:type="radial"
                android:centerX="-40"
                android:centerY="-60"
                android:gradientRadius="560">
                <item android:offset="0" android:color="#FFBFE56F" />
                <item android:offset="1" android:color="#00BFE56F" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M560.0,2320.0 a620.0,620.0 0 1,1 1240.0,0 a620.0,620.0 0 1,1 -1240.0,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="1180"
                android:centerY="2320"
                android:gradientRadius="620">
                <item android:offset="0" android:color="#FFFFB77D" />
                <item android:offset="1" android:color="#00FFB77D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
