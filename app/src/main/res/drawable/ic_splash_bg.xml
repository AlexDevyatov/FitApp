<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="803dp"
    android:viewportWidth="1080"
    android:viewportHeight="2408">

    <path android:pathData="M0,0 H1080 V2408 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="2408">
                <item android:offset="0" android:color="#FF10553C" />
                <item android:offset="1" android:color="#FF0D4F3A" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M-600.0,-60.0 a560.0,560.0 0 1,1 1120.0,0 a560.0,560.0 0 1,1 -1120.0,0 Z">
