<?xml version="1.0" encoding="utf-8"?>
<!-- Фон иконки «Свечение»: тот же градиент и те же пятна, что в ic_splash_bg.xml,
     но в системе 108 dp и с центром пятен за пределами кадра.
     Сгенерировано icons/build_icons_v6.py — правь скрипт, а не файл руками. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#0F543B" />
                <item android:offset="1" android:color="#0D503A" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M-62.6,-3.2 a58.3,58.3 0 1,1 116.6,0 a58.3,58.3 0 1,1 -116.6,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="-4.3"
                android:centerY="-3.2"
                android:gradientRadius="58.3">
                <item android:offset="0" android:color="#BFE56F" />
                <item android:offset="1" android:color="#00BFE56F" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M55.1,104.8 a62.6,62.6 0 1,1 125.3,0 a62.6,62.6 0 1,1 -125.3,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="117.7"
                android:centerY="104.8"
                android:gradientRadius="62.6">
                <item android:offset="0" android:color="#FFB77D" />
                <item android:offset="1" android:color="#00FFB77D" />
            </gradient>
        </aapt:attr>
    </path>
