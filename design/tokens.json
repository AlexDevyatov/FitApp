{
  "$schema": "https://fitapp.local/schemas/design-tokens.json",
  "meta": {
    "name": "FitApp Material 3",
    "version": "1.0.0",
    "description": "Дизайн-токены редизайна FitApp: светлая и тёмная темы, типографика, формы, отступы, движение.",
    "font": {
      "family": "Manrope",
      "fallback": ["Roboto", "sans-serif"],
      "numeric": "tnum"
    }
  },
  "color": {
    "light": {
      "background": "#F4F1E8",
      "onBackground": "#17211C",
      "surface": "#FFFFFF",
      "onSurface": "#17211C",
      "surfaceContainerLowest": "#FFFDF7",
      "surfaceContainerLow": "#FAF8F1",
      "surfaceContainer": "#F0EDE2",
      "surfaceContainerHigh": "#EAE6D9",
      "surfaceVariant": "#E9E5D9",
      "onSurfaceVariant": "#53645C",
      "primary": "#0E6B4F",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#CDEBDD",
      "onPrimaryContainer": "#002117",
      "secondary": "#C8F26A",
      "onSecondary": "#243300",
      "secondaryContainer": "#DFF5B4",
      "onSecondaryContainer": "#2F3B00",
      "tertiary": "#FFB77D",
      "onTertiary": "#4A2600",
      "tertiaryContainer": "#FFDCC2",
      "onTertiaryContainer": "#3A1B00",
      "error": "#BA1A1A",
      "onError": "#FFFFFF",
      "errorContainer": "#FFDAD6",
      "onErrorContainer": "#410002",
      "outline": "#7E8C85",
      "outlineVariant": "#DCE3DD",
      "scrim": "#000000",
      "inverseSurface": "#2C342E",
      "inverseOnSurface": "#EDF2ED",
      "inversePrimary": "#7FD8B0"
    },
    "dark": {
      "background": "#101613",
      "onBackground": "#E3EAE4",
      "surface": "#181F1B",
      "onSurface": "#E3EAE4",
      "surfaceContainerLowest": "#0B100D",
      "surfaceContainerLow": "#1F2722",
      "surfaceContainer": "#232B26",
      "surfaceContainerHigh": "#2E3731",
      "surfaceVariant": "#3F4943",
      "onSurfaceVariant": "#B7C5BC",
      "primary": "#7FD8B0",
      "onPrimary": "#003825",
      "primaryContainer": "#005138",
      "onPrimaryContainer": "#A4F2CE",
      "secondary": "#C8F26A",
      "onSecondary": "#243300",
      "secondaryContainer": "#3A4A00",
      "onSecondaryContainer": "#DFF5B4",
      "tertiary": "#FFB77D",
      "onTertiary": "#4A2600",
      "tertiaryContainer": "#6B3A00",
      "onTertiaryContainer": "#FFDCC2",
      "error": "#FFB4AB",
      "onError": "#690005",
      "errorContainer": "#93000A",
      "onErrorContainer": "#FFDAD6",
      "outline": "#8A9A91",
      "outlineVariant": "#3F4943",
      "scrim": "#000000",
      "inverseSurface": "#E3EAE4",
      "inverseOnSurface": "#2C342E",
      "inversePrimary": "#0E6B4F"
    },
    "extended": {
      "littleData": "#EF8A00",
      "emptyDay": "#B9B7AE",
      "success": "#2F7D4F",
      "limeWash": "#EEF9D6",
      "emeraldWash": "#E4F2EA"
    }
  },
  "typography": {
    "displayLarge": { "size": 57, "lineHeight": 64, "weight": 700, "tracking": -0.5 },
    "headlineLarge": { "size": 32, "lineHeight": 40, "weight": 700, "tracking": -0.4 },
    "headlineMedium": { "size": 28, "lineHeight": 36, "weight": 700, "tracking": -0.2 },
    "headlineSmall": { "size": 24, "lineHeight": 32, "weight": 700, "tracking": 0 },
    "titleLarge": { "size": 22, "lineHeight": 28, "weight": 600, "tracking": 0 },
    "titleMedium": { "size": 16, "lineHeight": 24, "weight": 600, "tracking": 0.1 },
    "titleSmall": { "size": 14, "lineHeight": 20, "weight": 600, "tracking": 0.1 },
    "bodyLarge": { "size": 16, "lineHeight": 24, "weight": 400, "tracking": 0.2 },
    "bodyMedium": { "size": 14, "lineHeight": 20, "weight": 400, "tracking": 0.2 },
    "bodySmall": { "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0.3 },
    "labelLarge": { "size": 15, "lineHeight": 20, "weight": 600, "tracking": 0.1 },
    "labelMedium": { "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0.4 },
    "labelSmall": { "size": 11, "lineHeight": 16, "weight": 500, "tracking": 0.4 },
    "numericDisplay": { "size": 57, "lineHeight": 60, "weight": 700, "tracking": -0.8, "feature": "tnum" }
  },
  "shape": {
    "extraSmall": 8,
    "small": 12,
    "medium": 16,
    "large": 22,
    "extraLarge": 28,
    "hero": 32,
    "full": 999
  },
  "spacing": {
    "unit": 4,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "screenGutter": 20,
    "cardPadding": 20,
    "sectionGap": 24
  },
  "elevation": {
    "level0": { "dp": 0, "shadow": "none" },
    "level1": { "dp": 1, "shadow": "0 2px 8px rgba(23,33,28,0.06)" },
    "level2": { "dp": 3, "shadow": "0 6px 18px rgba(23,33,28,0.08)" },
    "level3": { "dp": 6, "shadow": "0 12px 32px rgba(14,107,79,0.14)" }
  },
  "components": {
    "calorieRing": { "diameter": 220, "stroke": 14, "trackColorRole": "surfaceVariant", "cap": "round" },
    "macroChip": { "height": 64, "radius": 20, "padding": 12, "icon": 18 },
    "mealRow": { "height": 88, "photo": 64, "photoRadius": 18, "statusDot": 8 },
    "sectionCard": { "radius": 24, "padding": 20, "gap": 12 },
    "button": { "height": 56, "radius": 18, "paddingHorizontal": 24 },
    "statusChip": { "height": 24, "radius": 8, "paddingHorizontal": 8 },
    "segmentedButton": { "height": 40, "radius": 12 },
    "navigationBar": { "height": 80, "activePillWidth": 64, "activePillHeight": 32, "icon": 24 },
    "topAppBar": { "collapsedHeight": 64, "expandedHeight": 128, "titleSize": 32 },
    "fab": { "height": 56, "radius": 20, "margin": 16 },
    "emptyState": { "circle": 96, "icon": 40 }
  },
  "motion": {
    "short": 180,
    "medium": 260,
    "long": 300,
    "ring": 600,
    "easing": "cubic-bezier(0.2, 0.0, 0, 1.0)",
    "sharedElement": { "duration": 300, "enabled": true }
  }
}